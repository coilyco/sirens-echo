// The additive skill allowlist in agent-compose's role-graph format.
// See docs/sirens-echo-compose.md.

roles {
    // eng-platform is the sirens-dowel lane: room-craft plus engineering doctrine.
    // Globs so the deny list drops a match. Set and cost: deploy#658.
    role "eng-platform" {
        composed-skill "tooling-sirens-dowel-contract"
        composed-skill "tooling-sirens-dowel-temporal-brand"
        composed-skill "tooling-discord-community-host"
        composed-skill "personal-preference-*"
        composed-skill "personal-preferences"
        composed-skill "writing-*"
        composed-skill "coding-*"
        composed-skill "tooling-code-review"
        composed-skill "tooling-issue-*"
        composed-skill "tooling-skill-authoring"
        composed-skill "tooling-sysadmin-*"
        composed-skill "tooling-eval-*"
        composed-skill "tooling-browser-routing"
    }

    // Renamed creator, devrel, advocate, dev-advocate upstream. An entry for a role the
    // roster lost grants its skills to nothing. sirens-echo#7617.
    role "dev-advocate" {
        composed-skill "tooling-discord-community-host"
        composed-skill "tooling-devrel-*"
        composed-skill "personal-preference-*"
        composed-skill "personal-preferences"
        composed-skill "writing-*"
    }
}
